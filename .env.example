# Kristu Jayanti Institute of Technology MMS - Environment Configuration Template
# Copy this file to .env.local and populate the SMTP credentials.

# Base Application URL (used for password reset links in emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP Mail Server Configuration (Required for real email dispatch)
# Examples:
# For Google Workspace / Gmail: host=smtp.gmail.com, port=587, secure=false, user=your_email, password=app_password
# For Institutional SMTP / Microsoft 365: host=smtp.office365.com, port=587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@kristujayanti.edu.in"
SMTP_FROM_NAME="Kristu Jayanti Institute of Technology Media Management System"

# JWT Secret
JWT_SECRET="kjit-media-management-secret-key-2026"
